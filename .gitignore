.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/
dist/
build/

# Raw/normalized/output data is fetched and derived, not source-controlled by default.
# Keep the directory structure (see .gitkeep files) but not the (potentially large) contents.
data/raw/*/*/
data/normalized/**/*.json
data/normalized/**/*.jsonl
data/output/**/*.json
data/output/**/*.jsonl
data/output/**/*.csv
data/output/**/*.md
!tests/fixtures/**
